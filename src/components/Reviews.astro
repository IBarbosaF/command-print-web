---
const reviews = [
  {
    name: "El Patógrafo",
    initial: "P",
    text: "Buenos servicios con una atención amable y profesional. Compramos aquí los cartuchos y hacemos los envíos internacionales. ¡Siempre rápido y soluciones encontradas!",
    timeAgo: "Hace 3 meses",
  },
  {
    name: "David Soto",
    initial: "D",
    text: "Muy buena atención al cliente y también rapidez. La tienda y buena calidad.",
    timeAgo: "Hace 5 meses",
  },
  {
    name: "Camila Lissette Salina",
    initial: "C",
    text: "Muchas gracias. Muy buena atención.",
    timeAgo: "Hace un mes",
  },
  {
    name: "Paul Caiza",
    initial: "P",
    text: "Excelente atención al público",
    timeAgo: "Hace 5 meses",
  },
  {
    name: "Sara Selia",
    initial: "S",
    text: "Una tienda muy completa, muy atentos, profesionales y resolutivos.",
    timeAgo: "Hace un mes",
  },
];
---

<section id="resenas" class="w-full py-16 md:py-24 px-6 bg-white">
  <div class="max-w-6xl mx-auto">

    <div class="grid md:grid-cols-[280px_1fr] gap-10 items-start">

      <!-- Bloque de valoración -->
      <div>
        <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">
          Reseñas
        </h2>
        <p class="mt-2 text-slate-600">
          Lo que dicen nuestros clientes
        </p>

        <div class="mt-6 flex items-center gap-1 text-green-500 text-xl">
          <span>★★★★★</span>
        </div>
        <p class="mt-1 text-3xl font-semibold text-slate-900">4,8/5</p>
        <p class="text-sm text-slate-500">basado en reseñas de Google</p>
      </div>

      <!-- Tarjetas de reseñas -->
      <div class="grid sm:grid-cols-2 gap-4">
        {reviews.map((review) => (
          <div class="bg-slate-50 rounded-2xl border border-slate-100 p-5">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-full bg-green-100 text-green-700 flex items-center justify-center font-medium text-sm shrink-0">
                {review.initial}
              </div>
              <div class="min-w-0">
                <p class="font-medium text-slate-900 text-sm truncate">{review.name}</p>
                <p class="text-xs text-slate-500">{review.timeAgo} · Reseña de Google</p>
              </div>
            </div>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">
              {review.text}
            </p>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>