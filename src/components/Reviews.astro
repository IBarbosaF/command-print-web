---
const reviews = [
  {
    name: "Ronro Electrónica 2 C.A.",
    initial: "R",
    text: "Excelente servicio y atención al cliente, estoy muy satisfecho con la calidad de los consumibles y el servicio recibido. Los productos son de excelente calidad.",
    timeAgo: "Hace un mes",
  },
  {
    name: "Bass Ak47",
    initial: "B",
    text: "Command Print se posiciona como una empresa altamente confiable y especializada en la comercialización de cartuchos de impresora de alta calidad.",
    timeAgo: "Hace 6 meses",
  },
  {
    name: "Max David",
    initial: "M",
    text: "Excelente servicio para envío de paquetes con DHL y atención en general. Destaco la rapidez, lo eficientes que son y, sobre todo, la excelente atención.",
    timeAgo: "Hace 3 meses",
  },
  {
    name: "Bruno Cantonati",
    initial: "B",
    text: "Excelente atención, hacemos los envíos aquí, son rapidísimos, contratamos aquí Digi, muchas gracias la verdad, pagamos muchísimo menos, un acierto total y absoluto.",
    timeAgo: "Hace un mes",
  },
];

const googleReviewsUrl = "https://maps.app.goo.gl/Rh8SHR1ep9ZmsJsXA";
---

<section id="resenas" class="relative w-full py-16 md:py-16 px-6 bg-slate-50 overflow-hidden">
  <span class="halftone-reviews" aria-hidden="true"></span>
  <div class="max-w-6xl mx-auto">

    <div class="grid md:grid-cols-[280px_1fr] gap-10 items-start">

      <!-- Bloque de valoración -->
      <div class="relative">
        <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">
          Reseñas
        </h2>
        <p class="mt-2 text-slate-600">
          Lo que dicen nuestros clientes
        </p>

        <div class="mt-6 flex items-center gap-1 text-brand-light text-xl">
          <span>★★★★★</span>
        </div>
<p class="mt-1 text-3xl font-semibold text-slate-900">4,8/5</p>
<p class="text-sm text-slate-500 flex items-center gap-1.5 mt-1">
  basado en reseñas de
  <svg class="w-4 h-4" viewBox="0 0 48 48">
    <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.9 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.6 6.1 29.6 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.5z"/>
    <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.5 15.1 18.9 12 24 12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.6 6.1 29.6 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
    <path fill="#4CAF50" d="M24 44c5.2 0 10-2 13.6-5.2l-6.3-5.3C29.2 35.4 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.6 5.1C9.5 39.6 16.2 44 24 44z"/>
    <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-0.8 2.3-2.3 4.3-4.1 5.7l6.3 5.3C39.9 36.9 44 30.9 44 24c0-1.3-.1-2.7-.4-3.5z"/>
  </svg>
  Google
</p>

      </div>

      <!-- Tarjetas de reseñas -->
      <div>
        <div class="grid sm:grid-cols-2 gap-4">
          {reviews.map((review) => (
            <a
              href={googleReviewsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="review-card block bg-slate-50 rounded-2xl border-2 border-brand-light p-5"
            >
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-brand-light/10 text-brand-dark flex items-center justify-center font-medium text-sm shrink-0">
                  {review.initial}
                </div>
                <div class="min-w-0">
                  <p class="font-medium text-slate-900 text-sm truncate">{review.name}</p>
                  <p class="text-xs text-slate-500 flex items-center gap-1">
                    {review.timeAgo} · Reseña de
                    <svg class="w-3.5 h-3.5" viewBox="0 0 48 48">
                      <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.9 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.6 6.1 29.6 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.5z"/>
                      <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.5 15.1 18.9 12 24 12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.6 6.1 29.6 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
                      <path fill="#4CAF50" d="M24 44c5.2 0 10-2 13.6-5.2l-6.3-5.3C29.2 35.4 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.6 5.1C9.5 39.6 16.2 44 24 44z"/>
                      <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-0.8 2.3-2.3 4.3-4.1 5.7l6.3 5.3C39.9 36.9 44 30.9 44 24c0-1.3-.1-2.7-.4-3.5z"/>
                    </svg>
                    Google
                  </p>
                </div>
              </div>
              <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                {review.text}
              </p>
            </a>
          ))}
        </div>

        <div class="mt-6 text-center">
          <a
            href={googleReviewsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-sm text-brand-light hover:text-brand-dark-hover font-medium"
          >
            Ver más reseñas en Google →
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .review-card {
    position: relative;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
  }

  .review-card.is-active {
    border-color: var(--color-brand-light);
    box-shadow: 0 0 0 3px rgba(122, 183, 71, 0.15);
  }

  .halftone-reviews {
    position: absolute;
    bottom: -70px;
    left: -70px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background-image: radial-gradient(var(--color-brand-dark) 2px, transparent 2px);
    background-size: 10px 10px;
    opacity: 0.35;
    animation: spinReviews 45s linear infinite;
    pointer-events: none;
    z-index: 0;
  }

  .review-content {
    position: relative;
    z-index: 1;
  }

  @keyframes spinReviews {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .halftone-reviews { animation: none; }
  }
</style>

<script>
  document.querySelectorAll('.review-card').forEach((card) => {
    card.addEventListener('click', () => {
      card.classList.add('is-active');
      setTimeout(() => card.classList.remove('is-active'), 700);
    });
  });
</script>