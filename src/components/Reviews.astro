---
const reviews = [
  {
    name: "Ronro Electrónica 2 C.A.",
    initial: "R",
    text: "Excelente servicio y atención al cliente, estoy muy satisfecho con la calidad de los consumibles y el servicio recibido. Los productos son de excelente calidad.",
    timeAgo: "Hace un mes",
  },
  {
    name: "Bass Ak47",
    initial: "B",
    text: "Command Print se posiciona como una empresa altamente confiable y especializada en la comercialización de cartuchos de impresora de alta calidad.",
    timeAgo: "Hace 6 meses",
  },
  {
    name: "Max David",
    initial: "M",
    text: "Excelente servicio para envío de paquetes con DHL y atención en general. Destaco la rapidez, lo eficientes que son y, sobre todo, la excelente atención.",
    timeAgo: "Hace 3 meses",
  },
  {
    name: "Bruno Cantonati",
    initial: "B",
    text: "Excelente atención, hacemos los envíos aquí, son rapidísimos, contratamos aquí Digi, muchas gracias la verdad, pagamos muchísimo menos, un acierto total y absoluto.",
    timeAgo: "Hace un mes",
  },
];

const googleReviewsUrl = "https://maps.app.goo.gl/Rh8SHR1ep9ZmsJsXA";
---

<section id="resenas" class="w-full py-16 md:py-24 px-6 bg-white">
  <div class="max-w-6xl mx-auto">

    <div class="grid md:grid-cols-[280px_1fr] gap-10 items-start">

      <!-- Bloque de valoración -->
      <div>
        <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">
          Reseñas
        </h2>
        <p class="mt-2 text-slate-600">
          Lo que dicen nuestros clientes
        </p>

        <div class="mt-6 flex items-center gap-1 text-brand-light text-xl">
          <span>★★★★★</span>
        </div>
        <p class="mt-1 text-3xl font-semibold text-slate-900">4,8/5</p>
        <p class="text-sm text-slate-500">basado en reseñas de Google</p>

        <a
          href={googleReviewsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-1 text-sm text-brand-light hover:text-brand-dark-hover font-medium"
        >
          Ver todas en Google →
        </a>
      </div>

      <!-- Tarjetas de reseñas -->
      <div class="grid sm:grid-cols-2 gap-4">
        {reviews.map((review) => (
          <div class="bg-slate-50 rounded-2xl border border-slate-100 p-5">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-full bg-brand-light/10 text-brand-dark flex items-center justify-center font-medium text-sm shrink-0">
                {review.initial}
              </div>
              <div class="min-w-0">
                <p class="font-medium text-slate-900 text-sm truncate">{review.name}</p>
                <p class="text-xs text-slate-500">{review.timeAgo} · Reseña de Google</p>
              </div>
            </div>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">
              {review.text}
            </p>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>