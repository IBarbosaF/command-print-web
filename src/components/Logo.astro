---
interface Props {
  size?: "sm" | "lg";
}
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const { size = "sm" } = Astro.props;
const iconSize = size === "lg" ? "w-72 h-auto" : "w-36 h-auto";
const fontSize = size === "lg" ? "text-5xl md:text-6xl" : "text-2xl md:text-3xl";
---

<div class="logo-wrap inline-flex flex-col items-center -space-y-2">

  <span class="icon-mark relative inline-block">
    <span class="p" style="--tx:-30px;--ty:-18px;--sz:8px;--pc:var(--color-brand-light);--delay:.1s"></span>
    <span class="p" style="--tx:0px;--ty:-32px;--sz:6px;--pc:var(--color-brand-dark);--delay:.13s"></span>
    <span class="p" style="--tx:32px;--ty:-16px;--sz:9px;--pc:var(--color-brand-light);--delay:.08s"></span>
    <span class="p" style="--tx:36px;--ty:14px;--sz:6px;--pc:var(--color-brand-dark);--delay:.15s"></span>
    <span class="p" style="--tx:14px;--ty:30px;--sz:7px;--pc:var(--color-brand-light);--delay:.11s"></span>
    <span class="p" style="--tx:-18px;--ty:28px;--sz:8px;--pc:var(--color-brand-dark);--delay:.14s"></span>
    <span class="p" style="--tx:-34px;--ty:6px;--sz:6px;--pc:var(--color-brand-light);--delay:.09s"></span>
    <span class="p" style="--tx:-78px;--ty:28px;--sz:12px;--pc:var(--color-brand-dark);--delay:.68s"></span>
    <span class="p" style="--tx:72px;--ty:16px;--sz:14px;--pc:var(--color-brand-light);--delay:.70s"></span>
    <span class="p" style="--tx:68px;--ty:58px;--sz:8px;--pc:var(--color-brand-dark);--delay:.80s"></span>
    <span class="p" style="--tx:-46px;--ty:78px;--sz:10px;--pc:var(--color-brand-light);--delay:.78s"></span>
      <img src={`${base}logo-CP.svg`} alt="" class={iconSize} />
  </span>

  <div class:list={["wordmark inline-flex gap-2 font-bold", fontSize]}>
    <span class="word word-command">
      <span class="p" style="--tx:-38px;--ty:-22px;--sz:9px;--delay:.42s"></span>
      <span class="p" style="--tx:-10px;--ty:-40px;--sz:6px;--delay:.45s"></span>
      <span class="p" style="--tx:30px;--ty:-30px;--sz:7px;--delay:.4s"></span>
      <span class="p" style="--tx:42px;--ty:10px;--sz:5px;--delay:.47s"></span>
      <span class="p" style="--tx:20px;--ty:34px;--sz:8px;--delay:.43s"></span>
      <span class="p" style="--tx:-22px;--ty:32px;--sz:6px;--delay:.46s"></span>
      <span class="p" style="--tx:-42px;--ty:6px;--sz:5px;--delay:.41s"></span>      
      <span class="p" style="--tx:-68px;--ty:-58px;--sz:8px;--delay:.80s"></span>
      <span class="p" style="--tx:46px;--ty:-78px;--sz:10px;--delay:.78s"></span>
      <span class="p" style="--tx:-78px;--ty:28px;--sz:12px;--delay:.68s"></span>
      <span class="p" style="--tx:72px;--ty:16px;--sz:14px;--delay:.70s"></span>
      Command
    </span>

    <span class="word word-print">
      <span class="p" style="--tx:-36px;--ty:-20px;--sz:8px;--delay:.77s"></span>
      <span class="p" style="--tx:-8px;--ty:-38px;--sz:6px;--delay:.8s"></span>
      <span class="p" style="--tx:28px;--ty:-28px;--sz:9px;--delay:.75s"></span>
      <span class="p" style="--tx:40px;--ty:8px;--sz:5px;--delay:.82s"></span>
      <span class="p" style="--tx:18px;--ty:32px;--sz:7px;--delay:.78s"></span>
      <span class="p" style="--tx:-20px;--ty:30px;--sz:6px;--delay:.81s"></span>
      <span class="p" style="--tx:-40px;--ty:4px;--sz:5px;--delay:.76s"></span>
      <span class="p" style="--tx:68px;--ty:58px;--sz:8px;--delay:.80s"></span>
      <span class="p" style="--tx:-46px;--ty:78px;--sz:10px;--delay:.78s"></span>
      <span class="p" style="--tx:78px;--ty:-28px;--sz:12px;--delay:.68s"></span>
      <span class="p" style="--tx:-72px;--ty:-16px;--sz:14px;--delay:.70s"></span>
      Print
    </span>
  </div>

</div>

<style>
  .icon-mark {
    opacity: 0;
    transform: scale(2.2);
    animation: stamp 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: 0.05s;
  }

  .word {
    position: relative;
    display: inline-block;
    opacity: 0;
    transform: scale(1.6);
    filter: blur(3px);
    animation: appear 0.5s cubic-bezier(0.2, 1.4, 0.4, 1) forwards;
  }

  .word-command {
    color: var(--color-brand-light);
    animation-delay: 0.4s;
  }

  .word-print {
    color: var(--color-brand-dark);
    animation-delay: 0.75s;
  }

  .p {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--sz);
    height: var(--sz);
    background: var(--pc, currentColor);
    border-radius: 40% 60% 55% 45%;
    transform: translate(-50%, -50%) scale(0);
    opacity: 0;
    animation: fly 1s cubic-bezier(0.15, 0.7, 0.3, 1) forwards;
    animation-delay: var(--delay);
  }

  @keyframes stamp {
    0% { opacity: 0; transform: scale(2.2); }
    60% { opacity: 1; transform: scale(0.85); }
    100% { opacity: 1; transform: scale(1); }
  }

  @keyframes ring {
    0% { opacity: 0.8; transform: scale(0.6); }
    100% { opacity: 0; transform: scale(1.8); }
  }

  @keyframes appear {
    0% { opacity: 0; transform: scale(1.6); filter: blur(3px); }
    55% { opacity: 1; transform: scale(0.95); filter: blur(0); }
    100% { opacity: 1; transform: scale(1); filter: blur(0); }
  }

  @keyframes fly {
    0% { transform: translate(-50%, -50%) scale(0); opacity: 1; }
    25% { transform: translate(calc(-50% + var(--tx) * 0.4), calc(-50% + var(--ty) * 0.4)) scale(1); opacity: 1; }
    100% { transform: translate(calc(-50% + var(--tx)), calc(-50% + var(--ty))) scale(0.3); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .icon-mark, .word { animation: none; opacity: 1; transform: none; filter: none; }
    .p { display: none; }
  }
</style>