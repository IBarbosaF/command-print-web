---
const whatsappNumber = "34635897547"; // recuerda cambiar a 34641435033 en producción
const address = "C/ Real 60, San Sebastián de los Reyes, Madrid";
const mapQuery = encodeURIComponent(address);
---

<section id="contacto" class="w-full py-16 md:py-24 px-6 bg-slate-50">
  <div class="max-w-6xl mx-auto">

    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">
        Contacto
      </h2>
      <p class="mt-2 text-slate-600">
        Háblanos por WhatsApp y te responderemos lo antes posible
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">

      <!-- Formulario -->
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-8">
        <form id="quick-form" class="grid gap-4">
          <div>
            <label for="name" class="block text-sm font-medium text-slate-700 mb-1.5">Nombre</label>
            <input type="text" id="name" name="name" required placeholder="Tu nombre"
              class="w-full rounded-xl border border-slate-200 px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-light focus:border-transparent" />
          </div>

          <div>
            <label for="phone" class="block text-sm font-medium text-slate-700 mb-1.5">Teléfono</label>
            <input type="tel" id="phone" name="phone" required placeholder="Tu número de contacto"
              class="w-full rounded-xl border border-slate-200 px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-light focus:border-transparent" />
          </div>

          <div>
            <label for="model" class="block text-sm font-medium text-slate-700 mb-1.5">Modelo de cartucho/impresora</label>
            <input type="text" id="model" name="model" required placeholder="Ej: HP 305, Canon PG-560..."
              class="w-full rounded-xl border border-slate-200 px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-light focus:border-transparent" />
          </div>

          <button type="submit"
            class="mt-2 w-full bg-brand-light hover:bg-brand-dark-hover text-white font-medium px-6 py-3.5 rounded-full transition-colors">
            Enviar por WhatsApp
          </button>
        </form>

        <div class="mt-6 pt-6 border-t border-slate-100 text-center">
          <p class="text-sm text-slate-500 mb-3">¿Prefieres escribirnos directamente?</p>
          <a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-brand-light hover:text-brand-dark-hover font-medium text-sm">
            Escríbenos por WhatsApp →
          </a>
        </div>
      </div>

      <!-- Ubicación y horario -->
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden flex flex-col">
        <div class="aspect-[16/9]">
          <iframe
            title="Ubicación Command Print"
            src={`https://maps.google.com/maps?q=${mapQuery}&t=&z=16&ie=UTF8&iwloc=&output=embed`}
            width="100%"
            height="100%"
            style="border:0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

        <div class="p-8">
          <div class="flex items-start gap-3">
            <span class="text-brand-dark text-lg leading-none mt-0.5">📍</span>
            <div>
              <p class="text-slate-900 font-medium">C/ Real 60</p>
              <p class="text-slate-500 text-sm">San Sebastián de los Reyes, Madrid</p>
            </div>
          </div>

          <div class="mt-6 grid grid-cols-2 gap-6">
            <div>
              <p class="text-slate-900 font-medium text-sm">Lunes - viernes</p>
              <p class="text-slate-500 text-sm mt-1">10:00 - 14:00</p>
              <p class="text-slate-500 text-sm">17:00 - 20:00</p>
            </div>
            <div>
              <p class="text-slate-900 font-medium text-sm">Sábados</p>
              <p class="text-slate-500 text-sm mt-1">10:30 - 14:00</p>
            </div>
          </div>

          <div class="mt-6 pt-6 border-t border-slate-100">
            <p class="text-slate-900 font-medium text-sm">Atención por WhatsApp</p>
            <p class="text-slate-500 text-sm mt-1">10:00 a 21:30</p>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script define:vars={{ whatsappNumber }}>
  const form = document.getElementById("quick-form");

  form.addEventListener("submit", (e) => {
    e.preventDefault();

    const name = document.getElementById("name").value.trim();
    const phone = document.getElementById("phone").value.trim();
    const model = document.getElementById("model").value.trim();

    const message = `Hola, soy ${name} (tel: ${phone}). Quiero saber el precio de: ${model}`;
    const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;

    window.open(url, "_blank", "noopener,noreferrer");
  });
</script>