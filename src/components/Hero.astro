---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const whatsappNumber = "34641435033"; 
const whatsappMessage = encodeURIComponent("Hola, quiero información sobre cartuchos de tinta/tóner");
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<section class="relative w-full py-16 md:py-16 px-6 bg-white overflow-hidden">

  <!-- Trama de medios tonos -->
  <span class="halftone" aria-hidden="true"></span>

  <div class="relative max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-center">

    <!-- Columna izquierda: contenido -->
    <div>
      <h1 class="leading-none">
        <span class="relative inline-block">
          <span class="absolute inset-x-0 bottom-1 h-4 bg-brand-light/30 -z-10"></span>
          <span class="text-5xl md:text-6xl font-extrabold text-brand-light">Cartuchos de impresora y tóner</span>
        </span>
        <br />
        <span class="text-2xl md:text-3xl font-medium text-brand-dark">en Alcobendas y Sanse</span>
      </h1>

      <p class="mt-5 text-lg text-slate-600">
        Envío gratuito en menos de 3 horas o recogida en tienda.
      </p>

      <!-- Puntos CMYK -->
      <div class="flex gap-1.5 mt-5">
        <span class="cmyk-dot d1" style="background:#00AEEF;"></span>
        <span class="cmyk-dot d2" style="background:#EC008C;"></span>
        <span class="cmyk-dot d3" style="background:#FFF200; border:0.5px solid #e2e2df;"></span>
        <span class="cmyk-dot d4" style="background: #111111;"></span>
      </div>

      <!-- Bloque de ventajas clave -->
      <div class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="flex items-start gap-3">
          <!-- Stock -->
          <div class="w-14 h-14 rounded-full bg-brand-light/10 flex items-center justify-center shrink-0">
            <svg class="w-8 h-8 text-brand-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M12 3 3 7.5 12 12l9-4.5L12 3Z"/>
              <path d="M3 7.5V16l9 4.5V12"/>
              <path d="M21 7.5V16l-9 4.5V12"/>
              <path d="M7.5 5.25 16.5 9.75" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <p class="font-medium text-slate-900 text-sm">+3.000 cartuchos</p>
            <p class="text-sm text-slate-500">en stock, tinta y tóner</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <!-- Envío -->
          <div class="w-14 h-14 rounded-full bg-brand-light/10 flex items-center justify-center shrink-0">
            <svg class="w-8 h-8 text-brand-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M2 6h1" stroke-linecap="round"/>
              <path d="M1 9h2" stroke-linecap="round"/>
              <path d="M0.5 12h2.5" stroke-linecap="round"/>
              <path d="M5 7h10v9H5z"/>
              <path d="M15 10h3.5l2.5 2.5v3.5H15z"/>
              <circle cx="8.5" cy="18" r="1.6"/>
              <circle cx="18" cy="18" r="1.6"/>
            </svg>
          </div>
          <div>
            <p class="font-medium text-slate-900 text-sm">Envío gratis local</p>
            <p class="text-sm text-slate-500">menos de 3h en Alcobendas y Sanse</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <!-- Calidad -->
          <div class="w-14 h-14 rounded-full bg-brand-light/10 flex items-center justify-center shrink-0">
            <svg class="w-8 h-8 text-brand-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M12 2 4 5v6c0 5 3.5 8.5 8 11 4.5-2.5 8-6 8-11V5l-8-3Z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </div>
          <div>
            <p class="font-medium text-slate-900 text-sm">Calidad garantizada</p>
            <p class="text-sm text-slate-500">marcas premium</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Columna derecha: imagen + QR -->
    <div class="relative">
      <div class="bg-slate-50 rounded-2xl border border-slate-100 aspect-[4/3] overflow-hidden">
        <img
          src={`${base}escritorio.png`}
          alt="Mostrador de Command Print"
          class="w-full h-full object-cover block"
        />
      </div>

    </div>

  </div>
</section>

<style>
  .reg-mark {
    position: absolute;
    width: 14px;
    height: 14px;
    pointer-events: none;
  }
  .reg-mark::before {
    content: "";
    position: absolute;
    top: 6px;
    left: 0;
    width: 14px;
    height: 1px;
    background: #cbd5c8;
  }
  .reg-mark::after {
    content: "";
    position: absolute;
    top: 0;
    left: 6px;
    width: 1px;
    height: 14px;
    background: #cbd5c8;
  }

  .halftone {
    position: absolute;
    bottom: -60px;
    right: -60px;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background-image: radial-gradient(var(--color-brand-dark) 1.4px, transparent 1.4px);
    background-size: 9px 9px;
    opacity: 0.25;
    animation: spin 50s linear infinite;
    pointer-events: none;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .cmyk-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    opacity: 0;
    transform: scale(0);
    animation: popIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards, pulse 2.2s ease-in-out infinite;
  }
  .d1 { animation-delay: 0.1s, 0.5s; }
  .d2 { animation-delay: 0.28s, 0.68s; }
  .d3 { animation-delay: 0.46s, 0.86s; }
  .d4 { animation-delay: 0.64s, 1.04s; }

  @keyframes popIn {
    0% { opacity: 0; transform: scale(0); }
    100% { opacity: 1; transform: scale(1); }
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.25); }
  }

  @media (prefers-reduced-motion: reduce) {
    .halftone { animation: none; }
    .cmyk-dot { animation: popIn 0.3s ease forwards; opacity: 1; transform: scale(1); }
  }
</style>