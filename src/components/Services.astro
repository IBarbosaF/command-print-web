---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<section id="servicios" class="relative w-full py-16 md:py-24 px-6 bg-slate-50 overflow-hidden">

  <span class="halftone" aria-hidden="true"></span>

  <div class="relative max-w-6xl mx-auto">

    <div class="text-center max-w-2xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">
        Nuestros servicios
      </h2>
    </div>

    <div class="mt-12 grid sm:grid-cols-3 gap-6">

      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
        <span class="inline-block bg-brand-light/10 text-brand-light text-xs font-medium px-3 py-1 rounded-full mb-3">
          Lo más buscado
        </span>
        <div class="aspect-video bg-slate-50 rounded-xl overflow-hidden mb-4 border-2 border-brand-dark">
          <img src={`${base}cartuchos.png`} alt="Cartuchos de tinta y tóner" class="w-full h-full object-cover block" />
        </div>
        <h3 class="text-lg font-medium text-brand-dark">Comprar cartuchos</h3>
        <p class="mt-1 text-sm text-slate-500">Tinta, tóner y accesorios para tu impresora</p>
      </div>

      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
        <div class="aspect-video bg-slate-50 rounded-xl overflow-hidden mb-4 border-2 border-brand-dark">
          <img src={`${base}digi.png`} alt="Punto Digi" class="w-full h-full object-cover block" />
        </div>
        <h3 class="text-lg font-medium text-brand-dark">Punto Digi</h3>
        <p class="mt-1 text-sm text-slate-500">Gestiones y servicios digitales</p>
      </div>

      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
        <div class="aspect-video bg-brand-light/10 rounded-xl overflow-hidden mb-4 flex items-center justify-center p-4 border-2 border-brand-dark">
          <img src={`${base}dhlAmazon.png`} alt="Punto de recogida DHL y Amazon" class="max-w-full max-h-full object-contain block mx-auto" />
        </div>
        <h3 class="text-lg font-medium text-brand-dark">Punto de paquetería</h3>
        <p class="mt-1 text-sm text-slate-500">Recogida y envío sin cita previa (DHL y Amazon)</p>
      </div>

    </div>

  </div>
</section>

<style>
  .halftone {
    position: absolute;
    top: -60px;
    left: -60px;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background-image: radial-gradient(var(--color-brand-dark) 1.4px, transparent 1.4px);
    background-size: 9px 9px;
    opacity: 0.45;
    animation: spin 60s linear infinite;
    pointer-events: none;
  }
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .halftone { animation: none; }
  }
</style>