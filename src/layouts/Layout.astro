---
import '../styles/global.css'

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Command Print | Cartuchos de Tinta y Tóner en Sanse y Alcobendas",
  description = "Cartuchos de tinta y tóner con envío gratuito en menos de 3 horas en San Sebastián de los Reyes y Alcobendas. +3.000 cartuchos en stock, punto de recogida DHL y Amazon."
} = Astro.props;

const siteUrl = "https://www.commandprint.es";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}logo-CP.svg`} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />

    <!-- Open Graph (vista previa al compartir por WhatsApp) -->
    <meta property="og:type" content="business.business" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={`${siteUrl}/og-image.jpg`} />

    <!-- Schema.org LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Store",
      "name": "Command Print",
      "image": `${siteUrl}/og-image.jpg`,
      "url": siteUrl,
      "telephone": "+34641435033",
      "priceRange": "€€",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "C/ Real 60",
        "addressLocality": "San Sebastián de los Reyes",
        "addressRegion": "Madrid",
        "postalCode": "28700",
        "addressCountry": "ES"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "10:00",
          "closes": "14:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "17:00",
          "closes": "20:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Saturday",
          "opens": "10:30",
          "closes": "14:00"
        }
      ],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "reviewCount": "5"
      }
    })} />
  </head>
  <body class="bg-white text-slate-900 font-sans">
    <slot />
  </body>
</html>